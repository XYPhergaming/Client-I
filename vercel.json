{
  "rewrites": [
    { "source": "/MASTER_KEY/(.*)", "destination": "/$1" },
    { "source": "/PKG/(.*)", "destination": "/$1" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}